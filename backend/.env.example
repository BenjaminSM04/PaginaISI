# Base de datos
DATABASE_URL=postgresql://isi:isi_secret@localhost:5432/isi_portal?schema=public

# Servidor
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
# URL visible al navegador, sin /api; Next sirve /api y /uploads por proxy.
PUBLIC_WEB_URL=http://localhost:3000
TRUST_PROXY_HOPS=1
ENABLE_SWAGGER=true
AUTH_DEV_LINKS=true
# Correo real: AUTH_DEV_LINKS=false. En 587 usa SMTP_SECURE=false (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SICI Univalle
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_SECRET=

# JWT
# Genera dos valores distintos con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Cifrado AES-256-GCM para TOTP: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Storage: local | s3
STORAGE_DRIVER=local
UPLOADS_PER_USER_PER_DAY=25
# Solo si STORAGE_DRIVER=s3 (compatible con S3, MinIO, Supabase Storage, R2)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=isi-portal
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Docker/demo: carga datos solo si la tabla User está vacía.
SEED_ON_FIRST_RUN=false
# Reset demo manual: borra todos los datos y requiere confirmación explícita.
ALLOW_DEMO_SEED=false
