{
  "name": "isi-portal-api",
  "version": "1.0.0",
  "description": "API del Portal Académico de Ingeniería de Sistemas de la Universidad Privada del Valle",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.js",
    "check": "npm run typecheck && npm test",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push:dev": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "npm run seed:demo",
    "seed:demo": "ts-node --transpile-only prisma/seed.ts",
    "seed:presentation": "ts-node --transpile-only prisma/presentation-seed.ts",
    "test:auth:integration": "npm run build && node --test test/auth-integration.cjs"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "otpauth": "^9.5.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.35.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.11.0"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
