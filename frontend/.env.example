# Copiar a .env.local para desarrollo sin Docker.
# Solo servidor: destino del proxy y SSR, sin /api.
# Compose lo establece a http://api:4000 en runtime.
API_INTERNAL_URL=http://127.0.0.1:4000
# Metadatos públicos; requiere rebuild si cambia. No configura la API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# El navegador siempre usa /api y /uploads en su mismo origen.
